+      // it). Log the exception instead; nothing can meaningfully handle a void
+      // method's error on this thread.
+      NSLog(
+          @"[RCTTurboModule PATCH] NSException in async void method %s.%s — name: %@ reason: %@",
+          moduleName,
+          methodNameStr.c_str(),
+          exception.name,
+          exception.reason);
     } @finally {
       [retainedObjectsForInvocation removeAllObjects];
     }
