{
  "name": "i-planner-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "grant-access": "ts-node src/scripts/grantComplimentaryAccess.ts",
    "check-access": "ts-node src/scripts/checkAccess.ts",
    "announce": "ts-node src/scripts/sendAnnouncement.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.19.2",
    "firebase-admin": "^14.1.0",
    "googleapis": "^173.0.0",
    "mongoose": "^8.6.0",
    "openai": "^6.48.0",
    "resend": "^6.28.1",
    "sanitize-html": "^2.17.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/sanitize-html": "^2.16.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
