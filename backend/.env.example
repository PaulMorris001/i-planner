PORT=4000
MONGODB_URI=mongodb://localhost:27017/i-planner
CORS_ORIGIN=*

# Firebase Admin (for verifying ID tokens from the app) — pick ONE approach:
# 1) Paste the full service account JSON as a single line here, or
FIREBASE_SERVICE_ACCOUNT_JSON=
# 2) leave the above blank and set GOOGLE_APPLICATION_CREDENTIALS to a key file path instead,
#    or rely on it being auto-detected in a deployed GCP/Firebase environment.
FIREBASE_PROJECT_ID=

# Google Calendar OAuth (backend-relay flow — see src/routes/googleOAuth.routes.ts).
# Create a "Web application" type OAuth Client ID in Google Cloud Console with
# authorized redirect URI: <BACKEND_PUBLIC_URL>/api/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Any long random string, used to HMAC-sign the short-lived `state` param.
GOOGLE_OAUTH_STATE_SECRET=
# The backend's own publicly-reachable base URL — Google redirects here after consent.
BACKEND_PUBLIC_URL=

# OpenAI API key (platform.openai.com → API keys) — powers AI goal milestone
# generation (src/services/goalMilestones.ts) and, later, the AI Coach and
# onboarding generation.
OPENAI_API_KEY=

# AES-256 key (32 bytes, base64) encrypting stored Google OAuth tokens at rest
# (src/utils/tokenCrypto.ts). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a different key per environment — never reuse the local dev key in production.
TOKEN_ENCRYPTION_KEY=

# In-app purchases — verified directly against Apple/Google (no RevenueCat or
# other third-party cut). All optional until the store-side setup exists;
# left blank, purchase verification just errors per-request instead of
# crashing the backend. See src/services/appStoreVerify.ts / googlePlayVerify.ts.
#
# App Store Connect → App Information → Bundle ID.
APPLE_BUNDLE_ID=
# App Store Connect → App Information → "Apple ID" (a *numeric* id, not the
# bundle id). Only needed for verifying Production transactions.
APPLE_APP_ID=
# Play Console → Setup → API access → link/create a service account with
# "View financial data" access, download its JSON key, paste as one line here.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# The app's Android package name — matches app.json's expo.android.package.
GOOGLE_PLAY_PACKAGE_NAME=
